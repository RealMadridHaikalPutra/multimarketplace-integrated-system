# ==================================================================
# ENV TEMPLATE — copy to `.env` and fill in the values.
#   cp .env.example .env
# The real `.env` is NOT committed (contains secrets: tokens & database).
# ==================================================================

# ── Application ────────────────────────────────────────────────────
APP_NAME=Synchronization Service
APP_VERSION=0.1.0
DEBUG=false

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/sync_service
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── InvenTree (ERP) ────────────────────────────────────────────────
INVENTREE_STOCK_VIEW_URL=https://mirorim.ddns.net:6789/graphql/api/rest/vwStockAvailableInventree
INVENTREE_STOCK_SNAPSHOT_URL=https://mirorim.ddns.net:6789/graphql/api/rest/stockAvailableSnapshot
INVENTREE_API_URL=http://180.242.206.202:8004
INVENTREE_API_TOKEN=

# ── APISIX (Marketplace Gateway) ───────────────────────────────────
APISIX_BASE_URL=https://mirorim.ddns.net/apisix
APISIX_PRODUCTS_PATH=/products
APISIX_RESERVED_STOCK_PATH=/order
APISIX_ORDER_PATH=/order
# Base URL khusus panggilan ORDER (kosong = pakai APISIX_BASE_URL).
APISIX_ORDER_BASE_URL=
APISIX_UPDATE_STOCK_PATH=/update-stock
APISIX_UPDATE_STATUS_PATH=/update-status
APISIX_UPDATE_STATUS_TIMEOUT=30
APISIX_UPDATE_STOCK_TIMEOUT=30
APISIX_MAX_PAGES=100
APISIX_SHOPEE_SHOP_UUID=
APISIX_TIKTOK_SHOP_UUID=
APISIX_SHOPEE_DEFAULT_WAREHOUSE_ID=IDZ
APISIX_TIKTOK_DEFAULT_WAREHOUSE_ID=

# ── API server ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_ALLOWED_HOSTS=["*"]

# ── BACKEND BASE URL (self-call dari Camunda external task) ─────────
BACKEND_BASE_URL=http://127.0.0.1:8000
BACKEND_SELF_CALL_TIMEOUT=30

# ── Stock Sync Scheduler ───────────────────────────────────────────
STOCK_SYNC_ENABLED=true
STOCK_SYNC_AUTO_ENABLED=true
STOCK_SYNC_PUSH_ENABLED=true
STOCK_SYNC_REPORT_ONLY=false
STOCK_SYNC_SKIP_IF_PENDING=true
STOCK_SYNC_RETRY_ENABLED=true
STOCK_SYNC_MAX_RETRY_COUNT=3
STOCK_SYNC_RETRY_BACKOFF_SECONDS=2
STOCK_SYNC_RETRY_ERROR_MARKERS=400
STOCK_SYNC_SCHEDULE_TIME=09:41
STOCK_SYNC_SCHEDULE_TIMEZONE=Asia/Jakarta
STOCK_SYNC_REPORT_RETENTION_DAYS=7
STOCK_SYNC_LOG_RETENTION_DAYS=30
STOCK_SYNC_QUEUE_RETENTION_DAYS=7

# ── Mapping Validation (TC-SKU-006) ────────────────────────────────
MAPPING_BLOCK_PACK_SHARED_PART=true
SYNC_BLOCK_PACK_SX_CONFLICT=true
MAPPING_VALIDATION_ENABLED=true
VALIDATION_ISSUE_RETENTION_DAYS=30

# ── Inventory Report formula ───────────────────────────────────────
STOCK_BUFFER=0
INVENTREE_FACTOR_DEFAULT=1.0

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Camunda: webhook → start event / message ───────────────────────
CAMUNDA_ENABLED=true
CAMUNDA_BASE_URL=http://mirorim.ddns.net:8080
CAMUNDA_VERSION=7
CAMUNDA_REST_PATH=
CAMUNDA_MATCH_MODE=all
CAMUNDA_PROCESS_DEFINITION_KEY=
CAMUNDA_PROCESS_DEFINITION_ID=
CAMUNDA_MESSAGE_NAME=
CAMUNDA_TENANT_ID=
CAMUNDA_BUSINESS_KEY_TEMPLATE=
CAMUNDA_TYPED_VARIABLES=true
CAMUNDA_TIMEOUT_SECONDS=10
CAMUNDA_MAX_ATTEMPTS=3
CAMUNDA_RETRY_DELAY_SECONDS=1
CAMUNDA_RETRY_ON_STATUS=429,500,502,503,504
CAMUNDA_AUTH_TYPE=none
CAMUNDA_USERNAME=
CAMUNDA_PASSWORD=
CAMUNDA_TOKEN=
CAMUNDA_VERIFY_SSL=true
CAMUNDA_RULES_FILE=infrastructure/camunda/config.json
CAMUNDA_LOG_ENABLED=true
CAMUNDA_LOG_DIR=logs/camunda
CAMUNDA_LOG_FILENAME=camunda_trigger.log

# ── Webhook receiver (marketplace webhooks dari APISIX) ─────────────
WEBHOOK_LOG_ENABLED=true
WEBHOOK_LOG_DIR=logs/webhook
WEBHOOK_LOG_FILENAME=order_webhook.log
WEBHOOK_LOG_MAX_BODY_CHARS=20000
WEBHOOK_ORDER_DETAIL_ENABLED=true
WEBHOOK_ORDER_DETAIL_TRANSLATE=false
WEBHOOK_ORDER_DETAIL_TIMEOUT=30
WEBHOOK_PART_ID_ENABLED=true
WEBHOOK_RESERVED_ENABLED=true
WEBHOOK_RESERVED_MAX_PRODUCTS=20
WEBHOOK_RESERVED_RETRY_DELAY=3
WEBHOOK_ORDER_STATUS_ALLOWLIST=
